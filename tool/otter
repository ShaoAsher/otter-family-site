#!/usr/bin/env bash
# 水獭家族唯一 CLI。App 内 ./tool/otter <命令>（cwd=App 根，读 otter.json）。
#
# 真相
#   lib export|brand|publish|pull
# 片子
#   film pull <app> | film ingest <app>
# App
#   assets | package | notarize | release | ship
# 官网媒体（只写本地 library，上云用 lib publish）
#   site <demo|shots|art|promo|all>
# 发版枢纽
#   publish|mirror|status|ci-upload|launch
set -euo pipefail
T="$(cd "$(dirname "$0")" && pwd)"
cmd="${1:-}"
[[ $# -gt 0 ]] && shift
case "$cmd" in
  lib)
    sub="${1:-}"; [[ $# -gt 0 ]] && shift
    case "$sub" in
      export)  exec python3 "$T/export.py" "$@" ;;
      brand)   exec python3 "$T/brand_build.py" "$@" ;;
      publish) exec python3 "$T/sync_tos.py" library publish "$@" ;;
      pull)    exec python3 "$T/sync_tos.py" library pull "$@" ;;
      *) echo "用法：otter lib export|brand|publish|pull" >&2; exit 1 ;;
    esac
    ;;
  film)
    exec python3 "$T/film.py" "$@"
    ;;
  assets)
    if [[ $# -eq 0 ]]; then set -- pull; fi
    exec python3 "$T/app/assets.py" "$@" .
    ;;
  package)   exec bash "$T/app/package.sh" "$@" ;;
  notarize)  exec bash "$T/app/notarize.sh" "$@" ;;
  release)   exec bash "$T/app/release.sh" "$@" ;;
  site)      exec python3 "$T/app/site.py" "$@" ;;
  ship)      exec python3 "$T/release/ship.py" . "$@" ;;
  launch)    exec python3 "$T/release/launch.py" "$@" ;;
  publish|mirror|status)
             exec python3 "$T/release/release.py" "$cmd" "$@" ;;
  ci-upload) exec python3 "$T/release/ci_upload.py" "$@" ;;
  ""|help|-h|--help)
             sed -n '2,16p' "$0" ;;
  *)         echo "未知命令：${cmd}（./tool/otter help）" >&2; exit 1 ;;
esac
